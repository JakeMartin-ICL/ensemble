SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/auth/callback
ALLOWED_ORIGIN=http://127.0.0.1:5173
DB_HOST=aws-0-eu-west-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.[PROJECT-REF]
DB_PASSWORD=
DB_NAME=postgres
# Keep below the Supabase session-pooler pool_size. Raise only if the database pooler is sized for it.
DB_MAX_CONNECTIONS=5
DB_MIN_CONNECTIONS=0
DB_ACQUIRE_TIMEOUT_SECONDS=10
DB_IDLE_TIMEOUT_SECONDS=300
BIND_ADDR=0.0.0.0:3000
RUST_LOG=info
# Set to any value to log all Spotify API calls at INFO level
# SPOTIFY_LOG_CALLS=1
